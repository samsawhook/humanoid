# Life Dash environment. Copy to .env.local for local dev; set the same keys in Vercel.
# No secrets in the repo. Ever.

# Postgres (Neon or Vercel Postgres). Pooled connection string.
DATABASE_URL=

# Anthropic API. Planning uses claude-opus-5; capture parsing uses claude-sonnet-5.
ANTHROPIC_API_KEY=

# Bearer secret for /api/cron/* and the Telegram webhook. Long and random.
# Anything without it gets a 401.
CRON_SECRET=

# Telegram Bot API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ICS feed token. Lives in the URL path, because phones cannot send an
# Authorization header on a calendar subscription.
#
#   WARNING: anyone with the feed URL can read your entire plan.
#
# Rotate this independently of CRON_SECRET. Rotating it breaks the subscription
# on your phone and you have to re-add the calendar, which is the intended cost.
ICS_FEED_TOKEN=
# Feed URL once set:  $APP_BASE_URL/api/ics/<ICS_FEED_TOKEN>.ics

# Absolute base URL of the deployment, e.g. https://life-dash.vercel.app
# Used to build the ICS URL and Telegram callback URLs.
APP_BASE_URL=
